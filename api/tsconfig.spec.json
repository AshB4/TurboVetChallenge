{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/out-tsc",
    "module": "commonjs",
    "types": ["jest", "node"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2021"
  },
  "include": ["src/**/*.spec.ts", "src/**/*.test.ts"],
  "exclude": ["jest.config.ts"]
}
